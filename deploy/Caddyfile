# Set HERD_HOST (DNS name), HERD_OPERATOR, HERD_PASSWORD_HASH in /etc/herd/proxy.env.
# Obtain the hash with: caddy hash-password
{$HERD_HOST} {
    basic_auth {
        {$HERD_OPERATOR} {$HERD_PASSWORD_HASH}
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /health* {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        reverse_proxy 127.0.0.1:2718
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    log
}
