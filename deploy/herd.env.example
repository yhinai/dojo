# Owner root:herd, mode 0640. Store secrets in separate 0640 root:herd files.
HERD_STATE_DIR=/var/lib/herd
HERD_API_URL=http://127.0.0.1:8000
HERD_CONTROL_TOKEN_FILE=/etc/herd/secrets/control-token
WANDB_API_KEY_FILE=/etc/herd/secrets/wandb-key
WANDB_PROJECT=
HERD_DEMO_MODE=0
HERD_AUTH_READS=1
HERD_DOLLAR_CAP=10
HERD_MAX_WORKERS=4
PLAYWRIGHT_BROWSERS_PATH=/opt/herd/browsers
