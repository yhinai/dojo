[Unit]
Description=HERD single-operator experiment API and evidence synchronization
After=network-online.target docker.service
Requires=docker.service
[Service]
Type=simple
User=herd
Group=herd
SupplementaryGroups=docker
WorkingDirectory=/opt/herd
EnvironmentFile=/etc/herd/herd.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/herd/.venv/bin/herd serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/herd
[Install]
WantedBy=multi-user.target
