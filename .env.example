# Copy to .env. Keep this file local; do not commit credentials.
WANDB_API_KEY=
# Optional separate credential for an alternative OpenAI-compatible provider.
HERD_INFERENCE_API_KEY=
HERD_INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1
HERD_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Official W&B per-million-token prices verified 2026-09-13. No cache discount assumed.
HERD_INPUT_PRICE_PER_MILLION=0.13
HERD_OUTPUT_PRICE_PER_MILLION=0.28
HERD_PRICING_SOURCE=https://site.wandb.ai/pricing/tokens/
HERD_PRICING_VERIFIED_AT=2026-09-13
# Initial inference allowance only; ARIA or hosting charges are separate.
HERD_DOLLAR_CAP=25
HERD_MAX_WORKERS=4
# Use entity/project for W&B attribution and Weave.
WANDB_PROJECT=
HERD_WEAVE_PROJECT=
# Molab is browser-authenticated; these document the hosted verification target.
MOLAB_NOTEBOOK_URL=https://molab.marimo.io/
MOLAB_GPU_EXPECTED=RTX PRO 6000
# ARIA is accessed through the authenticated W&B UI and has no standalone key.
ARIA_AUTH_MODE=wandb_browser
ARIA_PROJECT=
# TypeSafe is optional until the sponsor provisions an invite and documents its endpoint/model.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
TYPESAFE_MODEL=
HERD_RUNTIME_MODE=docker
# Local dashboard mutations require this token; choose a random value.
HERD_CONTROL_TOKEN=
HERD_AUTH_READS=0
# Optional file-based secrets, required to be unreadable by other users:
# WANDB_API_KEY_FILE=/etc/herd/secrets/wandb-key
# HERD_CONTROL_TOKEN_FILE=/etc/herd/secrets/control-token
HERD_API_URL=http://127.0.0.1:8000
HERD_DEMO_MODE=1
HERD_STATE_DIR=experiments

# Opt in to redacted worker conversations in live Weave traces (default metadata only).
HERD_TRACE_CONVERSATIONS=0
